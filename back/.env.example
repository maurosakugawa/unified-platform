NODE_ENV=development
PORT=3101

# Gere um valor longo e aleatório em produção.
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Desenvolvimento separado com Vite.
# Em produção na mesma origem, pode ficar vazio.
FRONTEND_ORIGIN=http://localhost:3000

# false em HTTP local; true em produção com HTTPS.
COOKIE_SECURE=false

# Quantidade de proxies confiáveis à frente do Express.
TRUST_PROXY=1

# Relativo a back/ ou caminho absoluto.
PGDATA_PATH=./pgdata

# Nunca coloque a chave no frontend.
OPENWEATHER_API_KEY=sua-chave-openweather

# Apenas para testes/integradores. O padrão é a API oficial.
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
